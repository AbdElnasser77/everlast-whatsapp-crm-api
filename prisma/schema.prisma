generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MARKETING
  AGENT
  // An agent who also manages the agents: sees every chat and how it is
  // going (waiting, booking progress, outcomes) on the Supervision page.
  SUPERVISOR
}

// How a conversation ended up, set by the agent handling it. BOOKED always
// comes with a Booking row (the appointment details).
enum ConversationOutcome {
  BOOKED
  NOT_INTERESTED
  FOLLOW_UP
  NO_ANSWER
}

enum BookingStatus {
  BOOKED
  CANCELLED
}

// A patient's request to book, waiting for an agent to book it in Dok32.
enum BookingRequestStatus {
  NEW // nobody has picked it up
  IN_PROGRESS // an agent opened it and is booking it
  BOOKED // at least one appointment was booked from it
  NOT_BOOKED // closed without an appointment (notBookedReason says why)
}

enum BookingRequestSource {
  FLOW // the booking flow collected it
  AGENT // an agent created it from a chat
}

enum SenderType {
  CUSTOMER
  AGENT
  // Sent by a Flow (automation) — no human sender, senderId is null.
  BOT
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  INTERACTIVE
  STICKER
  // A Meta-approved template send (utils/templateSend.js). Distinct from
  // INTERACTIVE, which is an ad-hoc message only accepted inside the 24-hour
  // window — the difference matters to the window guard and to reporting.
  TEMPLATE
}

enum TemplateCategory {
  GENERAL
  RE_ENGAGEMENT
  CAMPAIGN
}

// Why a campaign was sent. Separate from TemplateCategory, which is the message
// type and drives Meta billing — every campaign template is CAMPAIGN there.
enum CampaignCategory {
  PROMOTION
  SEASONAL
  EVENT
  AWARENESS
  FOLLOW_UP
  ANNOUNCEMENT
  OTHER
}

enum TemplateHeaderType {
  NONE
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

enum TemplateApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  // Meta stopped the template after approval (low quality or too many blocks).
  // Neither can be sent; PAUSED may come back on its own (REINSTATED).
  PAUSED
  DISABLED
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum AgentStatus {
  ONLINE
  OFFLINE
  ON_BREAK
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

// Why a campaign is PAUSED. The scheduler auto-resumes only QUIET_HOURS —
// never a campaign a person paused, or one whose number went inactive.
enum CampaignPauseReason {
  MANUAL
  QUIET_HOURS
  NUMBER_INACTIVE
  // Meta refused a send for a reason that would fail every recipient (token,
  // payment, template problem, rate limit). Paused instead of burning the
  // audience; the recipients stay PENDING and Resume retries them.
  SEND_ERROR
  // Meta's throughput limit. Resumed automatically at Campaign.resumeAt.
  RATE_LIMIT
  // Repeated network failures reaching Meta. Resumed automatically at
  // Campaign.resumeAt; nobody is marked FAILED for a connection problem.
  CONNECTION
  // The template was deleted, paused or disabled. Needs a person: Resume
  // re-checks it.
  TEMPLATE_UNAVAILABLE
  // The number's Meta quality rating dropped (Settings → Campaign safety).
  // Needs a person: Resume re-checks the rating.
  QUALITY
}

enum CampaignRecipientStatus {
  PENDING
  // Claimed by a send loop: the Meta call is about to happen or in flight.
  // A row still SENDING after its loop died is never resent — recovery marks
  // it FAILED "Not confirmed", because Meta may already have delivered it.
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum Gender {
  MALE
  FEMALE
}

enum MediaAssetType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// One WhatsApp sending line. Everything the app sends with — the Meta phone
// number id and the token that can reach it — is resolved from a row here, never
// from the environment directly.
//
// The access TOKEN itself is deliberately NOT stored. `tokenEnvKey` names an
// environment variable, so a long-lived Meta token never enters Postgres or any
// database backup. utils/whatsappNumbers.js enforces an allow-list on that name
// at READ time: without it, a row could point this at JWT_SECRET or DATABASE_URL
// and any error path that echoes credentials becomes an exfiltration channel.
model WhatsAppNumber {
  id                 Int      @id @default(autoincrement())
  // What the switcher shows, e.g. "Clinic" / "Marketing".
  label              String
  phoneNumberId      String   @unique
  wabaId             String
  displayPhoneNumber String?
  tokenEnvKey        String
  // Meta App id, for the resumable-upload API used when submitting a template
  // with a media header. Null falls back to WHATSAPP_APP_ID — only needed if a
  // WABA ever sits under a second Meta App.
  appId              String?
  // Meta rate-limits per NUMBER, so in-flight sends are capped per number rather
  // than per process. Numbers sit at different throughput tiers, so this is a
  // column and not a shared constant.
  sendConcurrency    Int      @default(5)
  // Gates SENDING only. An inactive number still accepts inbound messages — the
  // line exists and a patient may still be talking on it.
  isActive           Boolean  @default(true)
  isDefault          Boolean  @default(false)
  // Meta's health signal for this line, as of qualityCheckedAt
  // (jobs/numberQualityWatch.js): GREEN / YELLOW / RED, and the account
  // status (CONNECTED / FLAGGED / RESTRICTED / BANNED).
  qualityRating      String?
  metaStatus         String?
  qualityCheckedAt   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversations Conversation[]
  campaigns     Campaign[]
  optOuts       CustomerOptOut[]

  @@index([wabaId])
  @@index([isActive])
}

// Per-number consent. A STOP sent to the marketing line must not silence the
// clinic's appointment reminders, so keyword opt-out is recorded against the
// number that received it rather than against the customer as a whole.
//
// This does NOT replace Customer.optedOut, which remains a global do-not-contact
// switch set by an admin or an import. The send path checks both.
model CustomerOptOut {
  id               Int            @id @default(autoincrement())
  customerId       Int
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsappNumberId Int
  whatsappNumber   WhatsAppNumber @relation(fields: [whatsappNumberId], references: [id], onDelete: Cascade)
  // "KEYWORD" | "MANUAL" | "IMPORT" | "WHATSAPP" — WHATSAPP is the customer
  // stopping "Offers and announcements" in WhatsApp itself (user_preferences
  // webhook, or Meta failing a send with 131050).
  source           String
  optedOutAt       DateTime       @default(now())

  @@unique([customerId, whatsappNumberId])
  @@index([whatsappNumberId])
}

model User {
  id                    Int            @id @default(autoincrement())
  name                  String?
  username              String         @unique @db.VarChar(20)
  passwordHash          String
  role                  Role           @default(AGENT)
  // Account enabled/disabled. Distinct from `status`, which is presence
  // (ONLINE/OFFLINE/ON_BREAK). A user with isActive=false is rejected by
  // `protect` on their next request and cannot log in at all.
  isActive              Boolean        @default(true)
  status                AgentStatus    @default(OFFLINE)
  lastActiveAt          DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  messages              Message[]
  assignedConversations Conversation[] @relation("AssignedConversations")
  campaigns             Campaign[]     @relation("CreatedCampaigns")
  submittedCampaigns    Campaign[]     @relation("SubmittedCampaigns")
  reviewedCampaigns     Campaign[]     @relation("ReviewedCampaigns")
  contactLists          ContactList[]
  segments              Segment[]
  mediaAssets           MediaAsset[]
  flows                 Flow[]
  outcomesSet       Conversation[]     @relation("ConversationOutcomes")
  bookingsCreated   Booking[]          @relation("BookingsCreated")
  conversationNotes ConversationNote[] @relation("ConversationNotes")
  bookingRequestsClaimed BookingRequest[] @relation("BookingRequestsClaimed")
  bookingRequestsHandled BookingRequest[] @relation("BookingRequestsHandled")
}

model MediaAsset {
  id          Int            @id @default(autoincrement())
  url         String
  publicId    String
  mediaType   MediaAssetType
  format      String
  bytes       Int
  width       Int?
  height      Int?
  filename    String?
  createdById Int?
  createdBy   User?          @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([mediaType])
}

model Customer {
  id                 Int                 @id @default(autoincrement())
  chartNumber        String?             @unique
  name               String?
  phone              String              @unique
  email              String?
  nationality        String?
  gender             Gender?
  dateOfBirth        DateTime?           @db.Date
  joinDate           DateTime?           @db.Date
  departments        String[]            @default([]) // ordered by rank: index 0 = top department
  tags               String[]            @default([])
  notes              String?
  // Global do-not-contact, set manually or by import. Distinct from CustomerOptOut,
  // which records a STOP received on one specific number. The send path must
  // check BOTH — this one suppresses every line.
  optedOut           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  // One conversation per number the customer has talked to, not one overall.
  conversations      Conversation[]
  optOuts            CustomerOptOut[]
  campaignRecipients CampaignRecipient[]
  listMemberships    ListMember[]
  flowRuns           FlowRun[]
  bookings           Booking[]
  bookingRequests    BookingRequest[]
}

model ContactList {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  createdById Int?
  createdBy   User?        @relation(fields: [createdById], references: [id])
  members     ListMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// A saved audience RULE, not a saved audience. `definition` holds
// { match, rules } and is re-evaluated every time the segment is used, so a
// patient who becomes eligible tomorrow is included tomorrow — the thing a
// ContactList structurally cannot do, since its membership is frozen the
// moment it is built.
//
// The rule grammar and its compilation to a Prisma `where` live in
// utils/segmentFilter.js; nothing else is allowed to interpret this column.
model Segment {
  id              Int        @id @default(autoincrement())
  name            String
  description     String?
  definition      Json
  // Segments are built for marketing sends, so consent exclusion is on by
  // default. It can be turned off for an operational audience (a service
  // notice, an export), but the campaign send path forces it back on
  // regardless of what is stored here.
  excludeOptedOut Boolean    @default(true)
  createdById     Int?
  createdBy       User?      @relation(fields: [createdById], references: [id])
  campaigns       Campaign[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([createdById])
}

model ListMember {
  id         Int         @id @default(autoincrement())
  listId     Int
  list       ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addedAt    DateTime    @default(now())

  @@unique([listId, customerId])
  @@index([customerId])
}

// A thread between one customer and ONE of our numbers. A customer who messages
// two of our lines has two conversations, each with its own 24-hour window —
// which is why customerId is no longer unique on its own.
model Conversation {
  id                    Int                @id @default(autoincrement())
  customerId            Int
  customer              Customer           @relation(fields: [customerId], references: [id])
  whatsappNumberId      Int
  whatsappNumber        WhatsAppNumber     @relation(fields: [whatsappNumberId], references: [id])
  assignedAgentId       Int?
  assignedAgent         User?              @relation("AssignedConversations", fields: [assignedAgentId], references: [id])
  status                ConversationStatus @default(OPEN)
  unreadCount           Int                @default(0)
  lastMessage           String?
  lastMessageAt         DateTime?
  lastSenderType        SenderType?
  lastCustomerMessageAt DateTime?
  // When the patient started waiting for a person: their first message since
  // a staff member (or the flow bot) last answered. Null = nobody is waiting.
  // What "replied and no follow-up" is measured from.
  awaitingReplySince    DateTime?
  // The last time a staff member (not a campaign, not the bot) replied.
  lastAgentReplyAt      DateTime?
  // Set by the agent; see ConversationOutcome.
  outcome               ConversationOutcome?
  outcomeAt             DateTime?
  outcomeById           Int?
  outcomeBy             User?              @relation("ConversationOutcomes", fields: [outcomeById], references: [id], onDelete: SetNull)
  // For FOLLOW_UP: when to get back to the patient.
  followUpAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  messages              Message[]
  flowRuns              FlowRun[]
  bookings              Booking[]
  bookingRequests       BookingRequest[]
  notes                 ConversationNote[]

  // The composite unique is what `upsert` keys on in the webhook path, and what
  // permits a second conversation for the same customer on a different number.
  @@unique([customerId, whatsappNumberId])
  // Every inbox list and count now carries a whatsappNumberId equality predicate,
  // so it leads each index — the difference between an index scan and a filter
  // over the whole table once several numbers share it.
  @@index([whatsappNumberId, lastMessageAt, lastSenderType, status])
  @@index([whatsappNumberId, assignedAgentId, status])
  @@index([whatsappNumberId, status])
  @@index([awaitingReplySince])
  @@index([outcome, followUpAt])
}

model Message {
  id                  Int                 @id @default(autoincrement())
  conversationId      Int
  conversation        Conversation        @relation(fields: [conversationId], references: [id])
  senderType          SenderType
  senderId            Int?
  sender              User?               @relation(fields: [senderId], references: [id])
  content             String
  messageType         MessageType         @default(TEXT)
  whatsappMessageId   String? @unique
  // Set by the browser for each message a person sends; unique, so a double
  // click or retry can never send the same message twice (utils/replyGuards.js).
  clientMessageId     String?             @unique
  mediaId             String?
  mediaUrl            String?
  status              MessageStatus?
  // Meta's billing verdict, copied from the `pricing` block of the status
  // webhook. Null until Meta reports it. billable is the authority on whether
  // this message cost money; pricingCategory is marketing / utility /
  // authentication / service, pricingType regular / free_customer_service.
  billable            Boolean?
  pricingCategory     String?
  pricingType         String?
  // Why Meta failed the send (from the status webhook's errors[0]). 131042 is
  // a payment-method problem on the WhatsApp account.
  errorCode           Int?
  errorTitle          String?
  reactions           Json?
  quotedMessageId     Int?
  quotedMessage       Message?            @relation("QuotedMessages", fields: [quotedMessageId], references: [id])
  quotingMessages     Message[]           @relation("QuotedMessages")
  // Set on an INBOUND message that answers a campaign: the recipient row it
  // replies to, which gives both the campaign and who was sent it. See the
  // attribution rule in modules/webhooks/webhook.controller.js. Null for every
  // other message.
  campaignRecipientId Int?
  campaignRecipient   CampaignRecipient?  @relation("RecipientReplies", fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  // The recipient rows this message was the campaign SEND for (the inverse of
  // CampaignRecipient.message).
  sentForRecipients   CampaignRecipient[] @relation("RecipientSentMessage")
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([conversationId, createdAt])
  @@index([whatsappMessageId])
  @@index([senderType, createdAt])
  @@index([campaignRecipientId])
}

// Templates belong to a WABA, not to a number. Numbers sharing a WABA therefore
// share this library automatically, and numbers on separate WABAs are isolated
// automatically — one code path covers both topologies.
model Template {
  id               Int                    @id @default(autoincrement())
  // Which WhatsApp Business Account this template was created under. Assigned at
  // creation from the active number and never editable afterwards: a template
  // approved on one WABA cannot be sent from a number on another, because Meta
  // rejects the template name as unknown.
  wabaId           String
  name             String
  metaTemplateName String?
  metaTemplateId   String?
  // Meta's own category (MARKETING / UTILITY / AUTHENTICATION) as Meta last
  // reported it — Meta can re-categorise an approved template, which changes
  // what it costs and which limits apply.
  metaCategory     String?
  category         TemplateCategory       @default(GENERAL)
  approvalStatus   TemplateApprovalStatus @default(DRAFT)
  rejectionReason  String?
  // When Meta last approved or rejected it. Drives the "approved since your
  // last visit" badge; null until Meta decides.
  statusChangedAt  DateTime?
  language         String                 @default("en_US")
  headerType       TemplateHeaderType     @default(NONE)
  header           String?
  headerMediaUrl   String?
  body             String
  footer           String?
  buttons          Json?
  // Present = a carousel template: the body is the text above 2–10 swipeable
  // cards, and header/footer/buttons are unused. Each card is
  // { mediaType: IMAGE|VIDEO, mediaUrl, body, buttons: [{ id, type, title, url? }] }
  // — see validateCards in modules/templates/template.controller.js.
  cards            Json?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  campaigns        Campaign[]

  // Meta enforces template-name uniqueness per WABA. Postgres permits unlimited
  // NULLs in a unique index, so DRAFT templates — which have no metaTemplateName
  // until submitForApproval writes one — are unaffected.
  @@unique([wabaId, metaTemplateName])
  @@index([wabaId, isActive])
}

model Campaign {
  id               Int                  @id @default(autoincrement())
  name             String
  templateId       Int
  template         Template             @relation(fields: [templateId], references: [id])
  // Business purpose, for filtering and reporting. Not the Meta billing
  // category — that lives on Template.
  category         CampaignCategory     @default(OTHER)
  // Which line this campaign sends from. Persisted rather than taken from the
  // request because the scheduler (jobs/campaignScheduler.js) runs on a cron tick
  // with no HTTP request, no user and no headers — the campaign row is the only
  // place it can learn the number. Set at creation, immutable once out of DRAFT.
  whatsappNumberId Int
  whatsappNumber   WhatsAppNumber       @relation(fields: [whatsappNumberId], references: [id])
  status           CampaignStatus       @default(DRAFT)
  pauseReason      CampaignPauseReason?
  // Human-readable reason for the pause (e.g. Meta's error), shown on the card.
  pauseDetail      String?
  // When an automatic pause (RATE_LIMIT / CONNECTION) is resumed by the scheduler.
  resumeAt         DateTime?
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  sentCount        Int                  @default(0)
  failedCount      Int                  @default(0)
  // Opted out (globally or on this line) by the time their turn came.
  skippedCount     Int                  @default(0)
  totalRecipients  Int                  @default(0)
  // Send-loop lease. Only the process holding an unexpired lease sends this
  // campaign; it renews it on every heartbeat. A crashed or killed process
  // stops renewing, and recovery takes the campaign over once it expires —
  // so two server instances can never send the same campaign at once.
  lockedBy         String?
  lockedUntil      DateTime?
  // Set when a COMPLETED campaign is deleted: hidden everywhere, but its
  // recipients and reply links stay so the history and reporting survive.
  deletedAt        DateTime?
  // Audience provenance. When a campaign is built from a segment, the segment
  // is resolved to concrete CampaignRecipient rows AT CREATION and frozen
  // there — the rule may keep evolving, but this campaign's audience does not.
  // These two columns record which rule produced it and what it looked like at
  // the time, so an approver can answer "who exactly did this go to, and why"
  // long after the segment has been edited.
  segmentId        Int?
  segment          Segment?             @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  audienceSnapshot Json?
  createdById      Int
  createdBy        User                 @relation("CreatedCampaigns", fields: [createdById], references: [id])
  // Approval trail. An agent may build a DRAFT and submit it; only an ADMIN
  // can approve, and approving IS the send authorization — a campaign is
  // immutable to agents from PENDING_APPROVAL onward, so the recipient list
  // can't change after review.
  submittedById    Int?
  submittedBy      User?                @relation("SubmittedCampaigns", fields: [submittedById], references: [id])
  submittedAt      DateTime?
  reviewedById     Int?
  reviewedBy       User?                @relation("ReviewedCampaigns", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  rejectionReason  String?
  // Optional automation that answers taps on this campaign's template buttons.
  flowId           Int?
  flow             Flow?                @relation(fields: [flowId], references: [id], onDelete: SetNull)
  flowRuns         FlowRun[]
  recipients       CampaignRecipient[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([whatsappNumberId, status])
  @@index([whatsappNumberId, category])
  @@index([status, pauseReason])
  bookingRequests  BookingRequest[]
}

model CampaignRecipient {
  id         Int                     @id @default(autoincrement())
  campaignId Int
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer                @relation(fields: [customerId], references: [id])
  status     CampaignRecipientStatus @default(PENDING)
  // The message the campaign SENT this recipient. Now a real foreign key; it was
  // a bare integer joined only in raw SQL.
  messageId  Int?
  message    Message?                @relation("RecipientSentMessage", fields: [messageId], references: [id], onDelete: SetNull)
  error      String?
  // Send attempts that reached the claim step. Caps retries of one recipient.
  attempts   Int                     @default(0)
  claimedAt  DateTime?
  sentAt     DateTime?
  // When this recipient first replied to the campaign. Set once, by the webhook,
  // and never moved — it is what "Replied" counts.
  repliedAt  DateTime?
  replies    Message[]               @relation("RecipientReplies")
  createdAt  DateTime                @default(now())

  @@index([campaignId])
  // One row per person per campaign: a duplicate would be messaged twice.
  @@unique([campaignId, customerId])
  // Serves the webhook's attribution lookup: this customer's recent campaigns.
  @@index([customerId, sentAt])
  @@index([messageId])
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  action        String
  actorId       Int?
  actorUsername String?
  targetType    String
  targetId      Int
  details       Json?
  createdAt     DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
}

// ─── Flows (campaign automation) ─────────────────────────────────────────────
// A Flow is a saved graph: a trigger (the campaign template's buttons) and the
// steps that follow — messages with buttons, lists, questions that collect
// data, tags, hand-off to an agent. `graph` is { nodes, edges } in the shape
// the builder (React Flow) edits; utils/flowGraph.js validates it on save and
// utils/flowEngine.js walks it.
model Flow {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean    @default(true)
  graph       Json
  createdById Int
  createdBy   User       @relation(fields: [createdById], references: [id])
  campaigns   Campaign[]
  runs        FlowRun[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum FlowRunStatus {
  // Executing or waiting for the customer's next tap/answer.
  ACTIVE
  COMPLETED
  // An agent took over (an Assign step, or an agent replied by hand).
  HANDED_OFF
  // The customer opted out, or a newer run replaced this one.
  STOPPED
  // No answer within the 24-hour window.
  EXPIRED
  FAILED
}

// One customer going through one flow. `data` is what the flow collected:
// { answers: { <variable>: value }, path: [{ node, choice, at }] } — the
// "responses" a flow's results page lists and exports.
model FlowRun {
  id             Int           @id @default(autoincrement())
  flowId         Int
  flow           Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversationId Int
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId     Int
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaignId     Int?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  status         FlowRunStatus @default(ACTIVE)
  // The step waiting for input; null once the run has finished.
  currentNodeId  String?
  data           Json          @default("{}")
  lastError      String?
  startedAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  @@index([conversationId, status])
  @@index([flowId, startedAt])
}

// Every webhook delivery from Meta, saved BEFORE Meta is told "200 OK". Meta
// never re-sends a delivery it got a 200 for, so this row is the only copy if
// the process dies before it is handled. processedAt is set once handling
// finished; jobs/webhookRecovery.js re-runs rows left unprocessed. Handling is
// idempotent (Message.whatsappMessageId is unique), so a re-run never
// duplicates a message.
model WebhookEvent {
  id          Int       @id @default(autoincrement())
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, receivedAt])
}

// Workspace settings an admin changes from the Settings page (quiet hours,
// campaign safety limits). One row per setting; value is the setting's JSON.
// Read through utils/appSettings.js, which caches them and falls back to the
// built-in defaults for anything never saved.
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById Int?
}

// An appointment an agent booked for a patient from a chat (outcome BOOKED).
// Kept as history: a patient can have many over time; a cancelled one stays,
// marked CANCELLED.
model Booking {
  id               Int           @id @default(autoincrement())
  conversationId   Int
  conversation     Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId       Int
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsappNumberId Int
  // The request it was booked from, and the campaign that request came from.
  requestId        Int?
  request          BookingRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  campaignId       Int?
  createdById      Int?
  createdBy        User?         @relation("BookingsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  appointmentAt    DateTime
  service          String?
  doctor           String?
  // The appointment's reference in Dok32, if the agent noted it.
  dok32Ref         String?
  note             String?
  status           BookingStatus @default(BOOKED)
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId, appointmentAt])
  @@index([createdAt])
  @@index([appointmentAt])
  @@index([requestId])
  @@index([campaignId])
}

// "This patient wants to book": created by the booking flow (or an agent),
// handled by an agent who books it in Dok32 and records the appointment(s).
model BookingRequest {
  id               Int                  @id @default(autoincrement())
  conversationId   Int
  conversation     Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId       Int
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsappNumberId Int
  source           BookingRequestSource
  // Where it came from: the campaign (if any) and the flow run that collected it.
  campaignId       Int?
  campaign         Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  flowRunId        Int?                 @unique
  // What the patient asked for, as collected: { service, preferred_date, … }.
  requested        Json                 @default("{}")
  note             String?
  status           BookingRequestStatus @default(NEW)
  claimedById      Int?
  claimedBy        User?                @relation("BookingRequestsClaimed", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt        DateTime?
  handledById      Int?
  handledBy        User?                @relation("BookingRequestsHandled", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt        DateTime?
  // For NOT_BOOKED: NO_ANSWER | NOT_INTERESTED | PRICE | CALL_BACK_LATER | BOOKED_ELSEWHERE | OTHER
  notBookedReason  String?
  notBookedNote    String?
  createdById      Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  bookings         Booking[]

  @@index([whatsappNumberId, status, createdAt])
  @@index([status, createdAt])
  @@index([conversationId])
  @@index([campaignId])
}

// A staff-only note on a chat ("call her back at 5"). Never sent to the patient.
model ConversationNote {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       Int?
  author         User?        @relation("ConversationNotes", fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
